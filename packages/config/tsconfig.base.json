{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@jastip/shared-types": ["packages/shared-types/src"],
      "@jastip/ui": ["packages/ui/src"],
      "@jastip/api-client": ["packages/api-client/src"],
      "@jastip/auth": ["packages/auth/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}